@model List<RoleListViewModel>

@{
    ViewData["Title"] = "Roller";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- BEGIN: MainContent -->
<main class="flex-1 overflow-y-auto space-y-6 bg-white">
    <!-- Header Controls Row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b-3 border-black pb-5">
        <div class="flex items-center gap-3">
            <h1 class="text-3xl font-black uppercase tracking-tight text-black">@ViewData["Title"]</h1>
            <span class="bg-brutal-purple text-black font-black text-xs px-3 py-1 border-3 border-black shadow-brutal-sm uppercase">@ViewBag.RoleCount ROLES</span>
        </div>
    </div>
    <!-- Clean Neobrutalist Table Container -->
    <div class="bg-white border-3 border-black shadow-brutal overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead class="bg-white border-b-3 border-black text-sm font-black uppercase tracking-wider">
                    <tr>
                        <th class="p-4 border-r-3 border-black">Rol Adı</th>
                        <th class="p-4 border-r-3 border-black">Kullanıcı Sayısı</th>
                        <th class="p-4 border-r-3 border-black">Yetkileri</th>
                        <th class="p-4 text-right">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="divide-y-3 divide-black text-sm font-bold">
                    @{
                        string color = "";
                        string userCountColor = "";
                        string roleInıtıals = "";
                        string roleDescription = "";

                    }

                    @foreach (var item in Model)
                    {
                        switch (item.Name)
                        {
                            case "Süper Admin":
                                color = "bg-[#FF6B6B]";
                                userCountColor = "text-white";
                                roleInıtıals = "SA";
                                roleDescription = "Tam Yetki. Site/Uygulama Sahibi ve Rol Atama";
                                break;
                            case "Admin":
                                color = "bg-brutal-yellow";
                                userCountColor = "text-black";
                                roleInıtıals = "AD";
                                roleDescription = "Sınırlı Yetki. İstatistiklere Göz Atabilir ve Şikayetleri Okuyabilir.";
                                break;
                            case "Standart Kullanıcı":
                                color = "bg-brutal-green";
                                userCountColor = "text-black";
                                roleInıtıals = "SK";
                                roleDescription = "Hesap Oluşturulduğu Anda Varsayılan Kullanıcı.";
                                break;
                            default:
                                color = "bg-brutal-blue-light";
                                userCountColor = "text-black";
                                break;
                        }

                        <tr class="hover:bg-neutral-50 transition-colors">
                            <td class="p-4 border-r-3 border-black">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 @color border-3 border-black flex items-center justify-center font-black text-sm shrink-0 shadow-brutal-sm">@roleInıtıals</div>
                                    <div>
                                        <div class="font-black text-sm uppercase">@item.Name</div>
                                    </div>
                                </div>
                            </td>
                            <td class="p-4 border-r-3 border-black">
                                <span class="@color @userCountColor font-mono text-[14px] font-black px-2 py-0.5 border-2 border-black uppercase shadow-brutal-sm">@item.UserCount Users</span>
                            </td>
                            <td class="p-4 border-r-3 border-black text-[14px] text-neutral-800 font-black">@roleDescription</td>
                            <td class="p-4 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <button class="px-3 py-1.5 bg-neutral-200 border-3 border-black text-sm font-bold uppercase cursor-not-allowed opacity-80 flex items-center gap-1 shadow-brutal-sm">
                                        <span>Kilitli</span> <span>🔒</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
<!-- END: MainContent -->
