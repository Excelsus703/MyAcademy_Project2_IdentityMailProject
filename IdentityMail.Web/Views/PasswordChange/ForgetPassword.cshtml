@model ForgetPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "~/Views/Shared/_RegisterLayout.cshtml";
}

@if (@ViewBag.SucceedState == null)
{
    <main class="bg-white brutal-border-4 brutal-card-shadow p-8 max-w-lg w-full relative z-10 my-8">
        <!-- Brand Header -->
        <header class="mb-5">
            <div class="flex items-center gap-2.5 mb-1.5" data-purpose="brand-logo">
                <span class="material-symbols-outlined text-black text-2xl" style="font-variation-settings: 'FILL' 0, 'wght' 700;">mail</span>
                <span class="text-2xl sm:text-[26px] font-black tracking-tight leading-none">CyberMail</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-black tracking-tight uppercase leading-tight">
                @ViewData["Title"]
            </h1>
            <!-- Solid Black Divider -->
            <hr class="mt-4 brutal-border border-b-0" />
        </header>
        <!-- Info / Tip Box -->
        <section class="brutal-border bg-tertiary-fixed/25 p-4 mb-6 flex items-start gap-3.5" data-purpose="instructions-banner">
            <!-- Yellow Lock Icon Box -->
            <div class="bg-brutal-yellow brutal-border p-2 flex-shrink-0 flex items-center justify-center">
                <span class="material-symbols-outlined text-black text-xl" style="font-variation-settings: 'FILL' 1, 'wght' 700;">lock</span>
            </div>
            <!-- Explanatory Copy -->
            <div class="text-[13px] sm:text-sm font-medium leading-snug">
                <p class="font-bold text-black mb-0.5">Parolanızı mı sıfırlamak istiyorsunuz?</p>
                <p class="text-neutral-800">
                    Kayıtlı e-posta adresinizi girin. Şifrenizi sıfırlamanız için size tek kullanımlık bir kurtarma bağlantısı göndereceğiz.
                </p>
            </div>
        </section>
        <!-- Reset Password Form -->
        <form class="space-y-5" method="post">
            <!-- Input Field Group -->
            <div data-purpose="email-input-group">
                <!-- Label Badge -->
                <label class="bg-black text-white text-xs font-bold px-2.5 py-1 uppercase tracking-wider inline-block mb-2" for="reset-email">
                    E-POSTA ADRESİ
                </label>
                <!-- Input Container -->
                <div class="relative flex items-center brutal-border bg-[#ece6ee]">
                    <span class="material-symbols-outlined absolute left-3.5 text-black pointer-events-none text-xl" style="font-variation-settings: 'wght' 600;">mail</span>
                    <input class="w-full bg-transparent border-0 pl-11 pr-4 py-3.5 text-base font-semibold text-black placeholder-neutral-500 focus:ring-0 focus:outline-none focus:bg-white transition-colors" placeholder="johndoe@example.com" required="" asp-for="Mail" type="email" />
                </div>
            </div>
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="my-lg p-md brutal-border bg-gray-100 border-l-[12px] border-l-brutal-red">
                    <p class="font-bold uppercase text-brutal-red mb-2">Hay Aksi !!!:</p>
                    @Html.ValidationSummary(false, string.Empty, new { @class = "list-disc pl-5 font-medium space-y-2" })
                </div>
            }
            <!-- Action Buttons Container -->
            <div class="pt-2 space-y-3" data-purpose="form-actions">
                <!-- Primary CTA Button -->
                <button class="brutal-btn-shadow brutal-border bg-brutal-yellow font-bold text-center py-3.5 w-full flex items-center justify-center gap-2 uppercase tracking-wide text-base text-black cursor-pointer" type="submit">
                    <span>SIFIRLAMA BAĞLANTISI GÖNDER</span>
                    <span class="material-symbols-outlined text-lg font-black" style="font-variation-settings: 'wght' 800;">arrow_forward</span>
                </button>
                <!-- Secondary Return Button -->
                <a class="brutal-btn-shadow brutal-border bg-white font-bold text-center py-3 w-full flex items-center justify-center gap-2 uppercase tracking-wide text-sm sm:text-base text-black hover:bg-neutral-50 block" href="/Auth/Login/">
                    <span class="material-symbols-outlined text-lg font-black" style="font-variation-settings: 'wght' 800;">arrow_back</span>
                    <span>GİRİŞ EKRANINA DÖN</span>
                </a>
            </div>
        </form>
        <!-- Help / Tip Card -->
        <div class="mt-6 brutal-border p-3 text-xs bg-white flex items-center gap-2 text-black leading-relaxed" data-purpose="help-tip-box">
            <span class="material-symbols-outlined text-base flex-shrink-0 text-black" style="font-variation-settings: 'wght' 600;">info</span>
            <div>
                <span class="font-bold">İpucu:</span> Kayıtlı e-postanıza erişemiyor musunuz?
                <a class="underline font-bold hover:text-neutral-700" href="#destek">Destek Ekibi</a> ile iletişime geçerek kimliğinizi doğrulayabilirsiniz.
            </div>
        </div>
        <!-- Footer Links -->
        <footer class="mt-6 pt-5 border-t-[3px] border-black text-center text-xs sm:text-sm font-medium">
            <span>Zaten şifrenizi hatırladınız mı?</span>
            <a class="ml-1.5 font-black text-black underline underline-offset-2 hover:bg-brutal-yellow hover:no-underline px-1 py-0.5 transition-colors" href="/Auth/Login/">
                Giriş Yap
            </a>
        </footer>
    </main>
}
else
{
    <main class="bg-white brutal-border-4 brutal-card-shadow p-8 max-w-lg w-full relative z-10 my-8">
        <!-- Brand Header -->
        <header class="mb-5">
            <div class="flex items-center gap-2.5 mb-1.5" data-purpose="brand-logo">
                <span class="material-symbols-outlined text-black text-2xl" style="font-variation-settings: 'FILL' 0, 'wght' 700;">mail</span>
                <span class="text-2xl sm:text-[26px] font-black tracking-tight leading-none">CyberMail</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-black tracking-tight uppercase leading-tight">
                Harika!
            </h1>
            <!-- Solid Black Divider -->
            <hr class="mt-4 brutal-border border-b-0" />
        </header>
        <!-- Info / Tip Box -->
        <section class="brutal-border bg-tertiary-fixed/25 p-4 mb-6 flex items-start gap-3.5" data-purpose="instructions-banner">
            <!-- Yellow Lock Icon Box -->
            <div class="bg-brutal-yellow brutal-border p-2 flex-shrink-0 flex items-center justify-center">
                <span class="material-symbols-outlined text-black text-xl" style="font-variation-settings: 'FILL' 1, 'wght' 700;">mark_email_unread</span>
            </div>
            <!-- Explanatory Copy -->
            <div class="text-[13px] sm:text-sm font-medium leading-snug">
                <p class="font-bold text-black mb-0.5">Şifre Değişiklik Talebiniz Alındı !</p>
                <p class="text-neutral-800">
                    En kısa sürede size cevap vericez. E-Postanızı kontrol etmeyi unutmayın !
                </p>
            </div>
        </section>
        <div class="pt-2 space-y-3" data-purpose="form-actions">
            <!-- Secondary Return Button -->
            <a class="brutal-btn-shadow brutal-border bg-white font-bold text-center py-3 w-full flex items-center justify-center gap-2 uppercase tracking-wide text-sm sm:text-base text-black hover:bg-neutral-50 block" href="/Auth/Login/">
                <span class="material-symbols-outlined text-lg font-black" style="font-variation-settings: 'wght' 800;">arrow_back</span>
                <span>GİRİŞ EKRANINA DÖN</span>
            </a>
        </div>
        <footer class="mt-6 pt-5 border-t-[3px] border-black text-center text-xs sm:text-sm font-medium">
        </footer>
    </main>
}