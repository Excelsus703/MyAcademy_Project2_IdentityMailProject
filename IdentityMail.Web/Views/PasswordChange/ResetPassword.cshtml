@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
    Layout = "~/Views/Shared/_RegisterLayout.cshtml";
}

@if (ViewBag.IsTokenStateNull == true)
{
    <main class="bg-white brutal-border-4 brutal-card-shadow p-8 max-w-lg w-full relative z-10 my-8">
        <!-- Brand Header -->
        <header class="mb-5">
            <div class="flex items-center gap-2.5 mb-1.5" data-purpose="brand-logo">
                <span class="material-symbols-outlined text-black text-2xl" style="font-variation-settings: 'FILL' 0, 'wght' 700;">mail</span>
                <span class="text-2xl sm:text-[26px] font-black tracking-tight leading-none">CyberMail</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-black tracking-tight uppercase leading-tight">Talep Geçerli Değil</h1>
            <!-- Solid Black Divider -->
            <hr class="mt-4 brutal-border border-b-0" />
        </header>
        <div class="my-lg p-md brutal-border bg-gray-100 border-l-[12px] border-l-brutal-red">
            <p class="font-bold uppercase text-brutal-red mb-2">Hay Aksi !!!:</p>
            Bu link geçerliliğini yitirmiştir. Lütfen yeni bir şifre değiştirme talebinde bulunun
        </div>
    </main>
}
else
{
    <main class="bg-white brutal-border-4 brutal-card-shadow p-8 max-w-lg w-full relative z-10 my-8">
        <!-- Brand Header -->
        <header class="mb-5">
            <div class="flex items-center gap-2.5 mb-1.5" data-purpose="brand-logo">
                <span class="material-symbols-outlined text-black text-2xl" style="font-variation-settings: 'FILL' 0, 'wght' 700;">mail</span>
                <span class="text-2xl sm:text-[26px] font-black tracking-tight leading-none">CyberMail</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-black tracking-tight uppercase leading-tight">@ViewData["Title"]</h1>
            <!-- Solid Black Divider -->
            <hr class="mt-4 brutal-border border-b-0" />
        </header>
        <!-- Info / Tip Box -->
        <section class="brutal-border bg-tertiary-fixed/25 p-4 mb-6 flex items-start gap-3.5" data-purpose="instructions-banner">
            <div class="bg-brutal-yellow brutal-border p-2 flex-shrink-0 flex items-center justify-center">
                <span class="material-symbols-outlined text-black text-xl" style="font-variation-settings: 'FILL' 1, 'wght' 700;">lock_reset</span>
            </div>
            <div class="text-[13px] sm:text-sm font-medium leading-snug">
                <p class="font-bold text-black mb-0.5">Yeni ve güçlü bir şifre belirleyin</p>
                <p class="text-neutral-800">Güvenliğiniz için en az 6 karakter, bir büyük harf, bir küçük harf, bir özel karakter ve bir rakam içermelidir.</p>
            </div>
        </section>
        <!-- Reset Password Form -->
        <form class="space-y-5" method="post">
            <!-- Input Field Group -->
            <div class="space-y-4" data-purpose="password-input-group">
                <div>
                    <label class="bg-black text-white text-xs font-bold px-2.5 py-1 uppercase tracking-wider inline-block mb-2" for="new-password">YENİ ŞİFRE</label>
                    <div class="relative flex items-center brutal-border bg-[#ece6ee]">
                        <span class="material-symbols-outlined absolute left-3.5 text-black pointer-events-none text-xl" style="font-variation-settings: 'wght' 600;">lock</span>
                        <input class="w-full bg-transparent border-0 pl-11 pr-11 py-3.5 text-base font-semibold text-black placeholder-neutral-500 focus:ring-0 focus:outline-none focus:bg-white transition-colors" placeholder="••••••••" required="" asp-for="Password" type="password" />
                    </div>
                </div>
                <div>
                    <label class="bg-black text-white text-xs font-bold px-2.5 py-1 uppercase tracking-wider inline-block mb-2" for="confirm-password">YENİ ŞİFRE (TEKRAR)</label>
                    <div class="relative flex items-center brutal-border bg-[#ece6ee]">
                        <span class="material-symbols-outlined absolute left-3.5 text-black pointer-events-none text-xl" style="font-variation-settings: 'wght' 600;">lock</span>
                        <input class="w-full bg-transparent border-0 pl-11 pr-4 py-3.5 text-base font-semibold text-black placeholder-neutral-500 focus:ring-0 focus:outline-none focus:bg-white transition-colors" placeholder="••••••••" required="" asp-for="ConfirmPassword" type="password" />
                    </div>
                </div>
            </div>

            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="my-lg p-md brutal-border bg-gray-100 border-l-[12px] border-l-brutal-red">
                    <p class="font-bold uppercase text-brutal-red mb-2">Hay Aksi !!!:</p>
                    @Html.ValidationSummary(false, string.Empty, new { @class = "list-disc pl-5 font-medium space-y-2" })
                </div>
            }
            <!-- Action Buttons Container -->
            <div class="pt-2 space-y-3" data-purpose="form-actions">
                <!-- Primary CTA Button -->
                <button class="brutal-btn-shadow brutal-border bg-brutal-yellow font-bold text-center py-3.5 w-full flex items-center justify-center gap-2 uppercase tracking-wide text-base text-black cursor-pointer" type="submit">
                    <span>ŞİFREYİ GÜNCELLE</span>
                    <span class="material-symbols-outlined text-lg font-black" style="font-variation-settings: 'wght' 800;">arrow_forward</span>
                </button>
            </div>
        </form>
        <!-- Help / Tip Card -->
        <div class="mt-6 brutal-border p-3 text-xs bg-white flex items-center gap-2 text-black leading-relaxed" data-purpose="help-tip-box">
            <span class="material-symbols-outlined text-base flex-shrink-0 text-black" style="font-variation-settings: 'wght' 600;">info</span>
            <div>
                <span class="font-bold">İpucu:</span> Şifrenizi güncelledikten sonra giriş sayfasına yönlendirileceksiniz.
            </div>
        </div>
    </main>
}