@{
    Layout = null;
}

<!DOCTYPE html>
<html class="dark" lang="en" style="">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - IdentityMail</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts & Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;900&display=swap" rel="stylesheet" />

    <!-- Unified Tailwind Configuration -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#4f378a",
                        "on-primary": "#ffffff",
                        "primary-container": "#6750a4",
                        "on-primary-container": "#e0d2ff",
                        "primary-fixed": "#e9ddff",
                        "primary-fixed-dim": "#cfbcff",
                        "on-primary-fixed": "#22005d",
                        "on-primary-fixed-variant": "#4f378a",
                        "inverse-primary": "#cfbcff",
                        "secondary": "#63597c",
                        "on-secondary": "#ffffff",
                        "secondary-container": "#e1d4fd",
                        "on-secondary-container": "#645a7d",
                        "secondary-fixed": "#e9ddff",
                        "secondary-fixed-dim": "#cdc0e9",
                        "on-secondary-fixed": "#1f1635",
                        "on-secondary-fixed-variant": "#4b4263",
                        "tertiary": "#765b00",
                        "on-tertiary": "#ffffff",
                        "tertiary-container": "#c9a74d",
                        "on-tertiary-container": "#503d00",
                        "tertiary-fixed": "#ffdf93",
                        "tertiary-fixed-dim": "#e7c365",
                        "on-tertiary-fixed": "#241a00",
                        "on-tertiary-fixed-variant": "#594400",
                        "background": "#fdf7ff",
                        "on-background": "#1d1b20",
                        "surface": "#fdf7ff",
                        "on-surface": "#1d1b20",
                        "surface-variant": "#e6e0e9",
                        "on-surface-variant": "#494551",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f8f2fa",
                        "surface-container": "#f2ecf4",
                        "surface-container-high": "#ece6ee",
                        "surface-container-highest": "#e6e0e9",
                        "surface-dim": "#ded8e0",
                        "surface-bright": "#fdf7ff",
                        "surface-tint": "#6750a4",
                        "inverse-surface": "#322f35",
                        "inverse-on-surface": "#f5eff7",
                        "outline": "#7a7582",
                        "outline-variant": "#cbc4d2",
                        "error": "#ba1a1a",
                        "on-error": "#ffffff",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a",
                        /* Neobrutalist Brand Colors */
                        "brutal-yellow": "#FFD700",
                        "brutal-blue": "#0055FF",
                        "brutal-red": "#FF2200",
                        "brutal-black": "#000000"
                    },
                    borderRadius: {
                        "DEFAULT": "0.125rem",
                        "sm": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "9999px"
                    },
                    spacing: {
                        "xs": "4px",
                        "sm": "8px",
                        "md": "16px",
                        "lg": "24px",
                        "xl": "32px",
                        "2xl": "48px",
                        "base": "4px",
                        "gutter": "16px",
                        "layout-margin": "24px",
                        "stack-sm": "8px",
                        "stack-md": "16px",
                        "stack-lg": "32px",
                        "margin-mobile": "16px",
                        "margin-desktop": "32px"
                    },
                    fontFamily: {
                        "sans": ['Space Grotesk', 'sans-serif'],
                        "body-md": ['Space Grotesk', 'sans-serif'],
                        "body-lg": ['Space Grotesk', 'sans-serif'],
                        "headline-md": ['Space Grotesk', 'sans-serif'],
                        "headline-lg": ['Space Grotesk', 'sans-serif'],
                        "label-md": ['Space Grotesk', 'sans-serif'],
                        "label-lg": ['Space Grotesk', 'sans-serif']
                    },
                    fontSize: {
                        "label": ["12px", { "lineHeight": "1", "fontWeight": "600" }],
                        "label-md": ["12px", { "lineHeight": "16px", "fontWeight": "500" }],
                        "label-lg": ["14px", { "lineHeight": "20px", "fontWeight": "500" }],
                        "body-sm": ["14px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "h2": ["24px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "700" }],
                        "h1": ["32px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "fontWeight": "700" }]
                    },
                    boxShadow: {
                        'brutal': '4px 4px 0px 0px rgba(0,0,0,1)',
                        'brutal-lg': '8px 8px 0px 0px rgba(0,0,0,1)'
                    }
                }
            }
        }
    </script>

    <!-- Custom Style Overrides -->
    <style>
        body {
            background-color: #f0f0f0;
            color: #000;
            font-family: 'Space Grotesk', sans-serif;
        }

        .brutal-border {
            border: 2px solid #000000;
        }

        .brutal-border-thick {
            border: 3px solid #000000;
        }

        .brutal-border-b {
            border-bottom: 3px solid #000000;
        }

        .brutal-border-r {
            border-right: 3px solid #000000;
        }

        .brutal-shadow {
            box-shadow: 4px 4px 0px 0px #000000;
            transition: transform 0.1s, box-shadow 0.1s;
        }

        .brutal-shadow-lg {
            box-shadow: 8px 8px 0px 0px #000000;
            transition: transform 0.1s, box-shadow 0.1s;
        }

            .brutal-shadow:active,
            .brutal-shadow-lg:active {
                box-shadow: 2px 2px 0px 0px #000000;
                transform: translate(2px, 2px);
            }

        .brutal-shadow-none {
            box-shadow: none !important;
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .dark \.bg-on-background {
            background-color: #fff;
        }

        .dark \.text-primary-fixed {
            color: #000;
        }

        .dark \.border-outline {
            border-color: #000;
        }

        #editor[data-empty="true"]::before {
            content: attr(data-placeholder);
            color: #9ca3af;
            pointer-events: none;
            position: absolute;
        }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            try {
                document.execCommand('styleWithCSS', false, false);
            } catch (e) {
                console.log("styleWithCSS desteklenmiyor.");
            }
        });
    </script>
</head>
<body class="flex h-screen overflow-hidden bg-white">
    <!-- SideNavBar (Neobrutalist Override) -->
    <nav class="fixed left-0 top-0 h-screen w-[240px] bg-white brutal-border-r flex flex-col py-lg px-md z-50">
        <!-- Brand -->
        <div class="mb-xl">
            <h1 class="font-h1 text-h1 font-bold text-black uppercase tracking-tighter">CyberMail</h1>

            @await Component.InvokeAsync("UserProfilePhoto")

            <br />

            <p class="font-label text-label text-black mt-xs uppercase bg-brutal-yellow inline-block px-1 border border-black" style="font-size:large;">@User.Identity.Name</p>
        </div>

        <!-- CTA -->
        <a href="/Message/SendMail/" class="bg-brutal-blue text-white brutal-border brutal-shadow font-label text-label uppercase py-md px-md mb-xl flex items-center justify-center gap-sm">
            <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">edit</span>
            Oluştur
        </a>
        <!-- Navigation Tabs -->
        <div class="flex-1 flex flex-col gap-sm">
            <a class="flex relative items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] @(ViewBag.ActiveTab == "Index" ? "bg-brutal-yellow" : "hover:bg-brutal-yellow") transition-colors"
               href="/Message/Index">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "Index" ? "1" : "0");">inbox</span>
                <span class="font-body-md text-body-md font-bold uppercase">Gelen Kutusu</span>
                @await Component.InvokeAsync("SidebarNotification")
            </a>
            <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] @(ViewBag.ActiveTab == "ImportantMessages" ? "bg-brutal-yellow" : "hover:bg-brutal-yellow") transition-colors" href="/Message/ImportantMessages/">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "ImportantMessages" ? "1" : "0");">star</span>
                <span class="font-body-md text-body-md font-bold uppercase">Önemliler</span>
            </a>
            <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] @(ViewBag.ActiveTab == "CategoryHome" ? "bg-brutal-yellow" : "hover:bg-brutal-yellow") transition-colors" href="/MessageCategory/CategoryHome/">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "CategoryHome" ? "1" : "0");">category</span>
                <span class="font-body-md text-body-md font-bold uppercase">Kategoriler</span>
            </a>
            <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] @(ViewBag.ActiveTab == "SentMessages" ? "bg-brutal-yellow" : "hover:bg-brutal-yellow") transition-colors" href="/Message/SentMessages/">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "SentMessages" ? "1" : "0");">send</span>
                <span class="font-body-md text-body-md font-bold uppercase">Gönderilenler</span>
            </a>
            <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] @(ViewBag.ActiveTab == "DraftMessages" ? "bg-brutal-yellow" : "hover:bg-brutal-yellow") transition-colors" href="/Message/DraftMessages">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "DraftMessages" ? "1" : "0");">description</span>
                <span class="font-body-md text-body-md font-bold uppercase">Taslaklar</span>
            </a>
            <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] @(ViewBag.ActiveTab == "TrashBox" ? "bg-brutal-yellow" : "hover:bg-brutal-yellow") transition-colors" href="/Message/TrashBox/">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "TrashBox" ? "1" : "0");">delete</span>
                <span class="font-body-md text-body-md font-bold uppercase">Çöp Kutusu</span>
            </a>
        </div>
        <!-- Footer Tabs -->
        <div class="mt-auto flex flex-col gap-sm pt-md brutal-border-t">
            <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] @(ViewBag.ActiveTab == "Settings" ? "bg-brutal-yellow" : "hover:bg-brutal-yellow") transition-colors" href="/UserSettings/Settings/">
                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "Settings" ? "1" : "0");">settings</span>
                <span class="font-body-md text-body-md font-bold uppercase">Profil Ayarları</span>
            </a>
            <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] hover:bg-brutal-red hover:text-white transition-colors" href="/Auth/Logout/">
                <span class="material-symbols-outlined">logout</span>
                <span class="font-body-md text-body-md font-bold uppercase">Çıkış Yap</span>
            </a>
        </div>
    </nav>
    <!-- Main Content Area -->
    <div class="ml-[240px] flex-1 flex flex-col w-[calc(100%-240px)] bg-gray-50">
        <!-- TopAppBar (Neobrutalist Override) -->
        <header class="fixed top-0 right-0 w-[calc(100%-240px)] z-40 bg-white brutal-border-b h-16 px-lg flex justify-between items-center">

            <div class="relative flex-1 max-w-xl">
                <form id="globalSearchForm" action="/Message/Index" method="get" class="flex brutal-border bg-white">

                    <!-- Arama Tipi Seçimi -->
                    <select id="searchTypeSelect" name="SearchType" class="bg-brutal-yellow font-bold text-xs uppercase px-3 py-2 brutal-border-r cursor-pointer outline-none border-none">
                        <option value="all">Tümü</option>
                        <option value="sender">İsim / Gönderen</option>
                        <option value="subject">Konu</option>
                        <option value="body">İçerik</option>
                    </select>

                    <!-- Input Alanı -->
                    <div class="relative flex-1 flex items-center">
                        <span class="material-symbols-outlined absolute left-3 text-black">search</span>
                        <input type="text"
                               id="globalSearchInput"
                               name="SearchTerm"
                               value="@Context.Request.Query["SearchTerm"]"
                               autocomplete="off"
                               placeholder="MESAJLARDA ARA..."
                               class="w-full bg-transparent py-2 pl-10 pr-4 font-bold text-sm uppercase text-black focus:outline-none" />
                    </div>
                </form>

                <!-- Canlı Sonuç Dropdown Paneli -->
                <div id="quickSearchResults" class="hidden absolute top-full left-0 right-0 mt-1 bg-white brutal-border shadow-[4px_4px_0_0_#000] z-50 max-h-80 overflow-y-auto">
                    <!-- JS Veriyi Buraya Dolduracak -->
                </div>
            </div>

            <!-- Trailing Actions -->
            <div class="flex items-center gap-md">

                @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("Süper Admin")))
                {
                    <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] bg-brutal-yellow transition-colors" href="/Admin/Dashboard/">
                        <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">identity_platform</span>
                        <span class="font-body-md text-body-md font-bold uppercase">Admin Paneli</span>
                    </a>
                }

                @await Component.InvokeAsync("Notification")

                <a href="/UserSettings/Settings/" class="w-10 h-10 brutal-border bg-brutal-blue brutal-shadow overflow-hidden flex items-center justify-center">
                    <span class="material-symbols-outlined text-white">account_circle</span>
                </a>
            </div>
        </header>
        <!-- Two Column Content Area -->
        @RenderBody()
    </div>

    @*Search Bar için JS*@
    <script>
                document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("globalSearchInput");
            const searchTypeSelect = document.getElementById("searchTypeSelect");
            const resultsContainer = document.getElementById("quickSearchResults");
            let debounceTimer = null;

            if (!searchInput || !resultsContainer) return;

            searchInput.addEventListener("input", function () {
                const term = this.value.trim();
                const searchType = searchTypeSelect.value;

                clearTimeout(debounceTimer);

                if (term.length < 2) {
                    resultsContainer.innerHTML = "";
                    resultsContainer.classList.add("hidden");
                    return;
                }

                debounceTimer = setTimeout(() => {
                    const params = new URLSearchParams({
                        SearchTerm: term,
                        SearchType: searchType
                    });

                    fetch(`/Message/QuickSearch?${params.toString()}`)
                        .then(res => res.json())
                        .then(data => {
                            resultsContainer.innerHTML = "";

                            if (data.length === 0) {
                                resultsContainer.innerHTML = `
                                    <div class="p-3 font-bold text-xs uppercase text-gray-500 text-center">
                                        Sonuç bulunamadı.
                                    </div>`;
                            } else {
                                data.forEach(item => {
                                    const row = document.createElement("a");
                                    row.href = `/Message/Index?id=${item.id}`;
                                    row.className = "block p-3 brutal-border-b hover:bg-brutal-yellow transition-colors cursor-pointer";
                                    row.innerHTML = `
                                        <div class="flex justify-between items-center text-xs font-bold uppercase mb-1">
                                            <span class="text-black">${item.senderFullName}</span>
                                            <span class="text-gray-500">${item.dateStr}</span>
                                        </div>
                                        <div class="text-sm font-extrabold uppercase text-black truncate">
                                            ${item.subject}
                                        </div>
                                    `;
                                    resultsContainer.appendChild(row);
                                });

                                const viewAll = document.createElement("a");
                                viewAll.href = `/Message/Index?SearchTerm=${encodeURIComponent(term)}&SearchType=${encodeURIComponent(searchType)}`;
                                viewAll.className = "block p-2 bg-black text-white text-center font-bold text-xs uppercase hover:bg-gray-800";
                                viewAll.innerText = "Tüm Sonuçları Gör ➔";
                                resultsContainer.appendChild(viewAll);
                            }

                            resultsContainer.classList.remove("hidden");
                        });
                }, 300);
            });

            document.addEventListener("click", function (e) {
                if (!searchInput.contains(e.target) && !resultsContainer.contains(e.target)) {
                    resultsContainer.classList.add("hidden");
                }
            });
        });
    </script>

</body>
</html>