@{
    Layout = null;
}

<!DOCTYPE html>

<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>CyberMail - KayıtOl</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts & Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />

    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        /* Neobrutalist Grid Pattern */
        .bg-neobrutal-grid {
            background-color: #f2ecf4; /* surface-container */
            background-image: linear-gradient(to right, #1d1b20 2px, transparent 2px), linear-gradient(to bottom, #1d1b20 2px, transparent 2px);
            background-size: 48px 48px;
        }

        /* Neobrutalist Sınıfları */
        .brutal-border {
            border: 3px solid #000;
        }

        .brutal-border-4 {
            border: 4px solid #000;
        }

        .brutal-card-shadow {
            box-shadow: 10px 10px 0px 0px #000;
        }

        .brutal-btn-shadow {
            box-shadow: 4px 4px 0px 0px #000;
            transition: transform 0.1s ease, box-shadow 0.1s ease;
        }

            .brutal-btn-shadow:hover {
                transform: translate(-1px, -1px);
                box-shadow: 5px 5px 0px 0px #000;
            }

            .brutal-btn-shadow:active {
                transform: translate(3px, 3px);
                box-shadow: 1px 1px 0px 0px #000;
            }

        /* OTP input focus styling */
        .otp-box:focus {
            outline: none;
            background-color: #fff;
            box-shadow: 3px 3px 0px 0px #000;
        }

        /* Scrollbar Gizleme */
        ::-webkit-scrollbar {
            display: none;
        }
    </style>

    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "secondary": "#63597c",
                        "on-surface": "#1d1b20",
                        "on-primary-fixed-variant": "#4f378a",
                        "on-tertiary-fixed": "#241a00",
                        "surface-container": "#f2ecf4",
                        "surface-container-lowest": "#ffffff",
                        "on-primary": "#ffffff",
                        "on-secondary-fixed": "#1f1635",
                        "on-background": "#1d1b20",
                        "on-error": "#ffffff",
                        "surface-variant": "#e6e0e9",
                        "tertiary-fixed": "#ffdf93",
                        "on-surface-variant": "#494551",
                        "tertiary": "#765b00",
                        "secondary-container": "#e1d4fd",
                        "error": "#ba1a1a",
                        "surface-container-low": "#f8f2fa",
                        "primary-fixed-dim": "#cfbcff",
                        "tertiary-container": "#c9a74d",
                        "inverse-primary": "#cfbcff",
                        "surface-container-high": "#ece6ee",
                        "inverse-surface": "#322f35",
                        "on-tertiary-fixed-variant": "#594400",
                        "secondary-fixed": "#e9ddff",
                        "on-primary-container": "#e0d2ff",
                        "primary": "#4f378a",
                        "surface-tint": "#6750a4",
                        "surface-dim": "#ded8e0",
                        "on-secondary-fixed-variant": "#4b4263",
                        "inverse-on-surface": "#f5eff7",
                        "error-container": "#ffdad6",
                        "background": "#fdf7ff",
                        "surface-container-highest": "#e6e0e9",
                        "on-tertiary-container": "#503d00",
                        "primary-container": "#6750a4",
                        "secondary-fixed-dim": "#cdc0e9",
                        "primary-fixed": "#e9ddff",
                        "on-tertiary": "#ffffff",
                        "surface-bright": "#fdf7ff",
                        "on-primary-fixed": "#22005d",
                        "tertiary-fixed-dim": "#e7c365",
                        "outline": "#7a7582",
                        "on-secondary": "#ffffff",
                        "surface": "#fdf7ff",
                        "on-error-container": "#93000a",
                        "outline-variant": "#cbc4d2",
                        "on-secondary-container": "#645a7d",
                        /* Neobrutalist Ekstra Renkler */
                        "brutal-yellow": "#FFD700",
                        "brutal-blue": "#0055FF",
                        "brutal-red": "#FF2200",
                        "brutal-black": "#000000"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "sm": "8px",
                        "gutter": "16px",
                        "base": "4px",
                        "2xl": "48px",
                        "md": "16px",
                        "lg": "24px",
                        "xl": "32px",
                        "layout-margin": "24px",
                        "xs": "4px"
                    },
                    "fontFamily": {
                        "sans": ['Space Grotesk', 'sans-serif']
                    },
                    "fontSize": {
                        "h1": [
                            "32px",
                            {
                                "lineHeight": "1.2",
                                "letterSpacing": "-0.02em",
                                "fontWeight": "700"
                            }
                        ],
                        "body-lg": [
                            "18px",
                            {
                                "lineHeight": "1.6",
                                "fontWeight": "400"
                            }
                        ],
                        "h2": [
                            "24px",
                            {
                                "lineHeight": "1.3",
                                "fontWeight": "600"
                            }
                        ],
                        "label": [
                            "12px",
                            {
                                "lineHeight": "1",
                                "fontWeight": "600"
                            }
                        ],
                        "body-md": [
                            "16px",
                            {
                                "lineHeight": "1.5",
                                "fontWeight": "400"
                            }
                        ],
                        "body-sm": [
                            "14px",
                            {
                                "lineHeight": "1.5",
                                "fontWeight": "400"
                            }
                        ]
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-neobrutal-grid min-h-screen w-full flex items-center justify-center p-md sm:p-lg text-on-background">
    @RenderBody()
    <!-- Decorative floating elements (Neobrutalist accents) -->
    <div class="absolute top-10 left-10 w-16 h-16 bg-primary border-[3px] border-on-background shadow-[4px_4px_0px_0px_#1d1b20] rounded-full hidden lg:block animate-pulse"></div>
    <div class="absolute bottom-20 right-20 w-24 h-8 bg-error border-[3px] border-on-background shadow-[4px_4px_0px_0px_#1d1b20] hidden lg:block rotate-12"></div>
</body>
</html>