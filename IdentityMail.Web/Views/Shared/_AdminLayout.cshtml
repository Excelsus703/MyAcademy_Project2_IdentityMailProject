@{
    Layout = null;
}

<!DOCTYPE html>

<html class="dark" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>EmailPro Admin - Neobrutalist Dashboard</title>

    <!-- Tailwind CSS v3 with Plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>

    <!-- Google Fonts: Space Mono, Space Grotesk & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700;800;900&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet" />

    <!-- Unified Tailwind Configuration -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        // Neobrutalist Vibrant Palette
                        "brutal-yellow": "#FFDE59",
                        "brutal-blue": "#2563EB",
                        "brutal-blue-light": "#93C5FD",
                        "brutal-green": "#86EFAC",
                        "brutal-purple": "#D8B4FE",
                        "brutal-red": "#FF2200",
                        "brutal-coral": "#FF6B6B",
                        "neo-yellow": "#FBBF24",

                        // System & Surface Palette
                        "surface-container-highest": "#e6e0e9",
                        "primary-fixed-dim": "#cfbcff",
                        "inverse-on-surface": "#f5eff7",
                        "tertiary-fixed": "#ffdf93",
                        "on-surface": "#1d1b20",
                        "on-primary": "#ffffff",
                        "on-secondary": "#ffffff",
                        "on-secondary-fixed-variant": "#4b4263",
                        "secondary-fixed-dim": "#cdc0e9",
                        "surface-container-high": "#ece6ee",
                        "on-secondary-container": "#645a7d",
                        "on-primary-container": "#e0d2ff",
                        "secondary-fixed": "#e9ddff",
                        "tertiary": "#765b00",
                        "inverse-primary": "#cfbcff",
                        "inverse-surface": "#322f35",
                        "secondary": "#63597c",
                        "on-background": "#1d1b20",
                        "surface-dim": "#ded8e0",
                        "surface-variant": "#e6e0e9",
                        "on-error": "#ffffff",
                        "error": "#ba1a1a",
                        "surface": "#fdf7ff",
                        "surface-tint": "#6750a4",
                        "on-tertiary-fixed-variant": "#594400",
                        "on-surface-variant": "#494551",
                        "background": "#fdf7ff",
                        "on-error-container": "#93000a",
                        "on-primary-fixed": "#22005d",
                        "surface-container-lowest": "#ffffff",
                        "primary": "#4f378a",
                        "surface-bright": "#fdf7ff",
                        "on-tertiary-fixed": "#241a00",
                        "outline": "#7a7582",
                        "tertiary-fixed-dim": "#e7c365",
                        "secondary-container": "#e1d4fd",
                        "surface-container": "#f2ecf4",
                        "primary-fixed": "#e9ddff",
                        "on-tertiary": "#ffffff",
                        "surface-container-low": "#f8f2fa",
                        "on-primary-fixed-variant": "#4f378a",
                        "primary-container": "#6750a4",
                        "outline-variant": "#cbc4d2",
                        "on-secondary-fixed": "#1f1635",
                        "error-container": "#ffdad6",
                        "tertiary-container": "#c9a74d",
                        "on-tertiary-container": "#503d00"
                    },
                    boxShadow: {
                        "brutal": "4px 4px 0px 0px #000000",
                        "brutal-sm": "2px 2px 0px 0px #000000",
                        "brutal-lg": "6px 6px 0px 0px #000000",
                        "brutal-hover": "1px 1px 0px 0px #000000"
                    },
                    borderRadius: {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    spacing: {
                        "lg": "24px",
                        "base": "4px",
                        "xl": "32px",
                        "xs": "4px",
                        "md": "16px",
                        "layout-margin": "24px",
                        "sm": "8px",
                        "gutter": "16px",
                        "2xl": "48px"
                    },
                    fontFamily: {
                        "grotesk": ['"Space Grotesk"', 'sans-serif'],
                        "mono": ['"Space Mono"', 'monospace']
                    },
                    fontSize: {
                        "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "h1": ["32px", { "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "h2": ["24px", { "lineHeight": "1.3", "fontWeight": "600" }],
                        "body-sm": ["14px", { "lineHeight": "1.5", "fontWeight": "400" }],
                        "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
                        "label": ["12px", { "lineHeight": "1", "fontWeight": "600" }]
                    }
                }
            }
        }
    </script>

    <!-- Custom Neobrutalist Styles & Overrides -->
    <style>
        body {
            font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            letter-spacing: -0.015em;
            background-color: #f0f0f0;
            color: #000;
        }

        /* Neobrutalist Utility Classes */
        .neobrutalist-shadow {
            box-shadow: 8px 8px 0px 0px #000000;
        }

        .neobrutalist-border {
            border: 3px solid #000000;
        }

        .neobrutalist-hover:hover {
            transform: translate(-4px, -4px);
            box-shadow: 8px 8px 0px 0px #000000;
        }

        .neobrutalist-active:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px 0px #000000;
        }

        /* Border Utility Classes */
        .border-3 {
            border-width: 3px;
        }

        .border-t-3 {
            border-top-width: 3px;
        }

        .border-b-3 {
            border-bottom-width: 3px;
        }

        .border-l-3 {
            border-left-width: 3px;
        }

        .border-r-3 {
            border-right-width: 3px;
        }

        /* Dark Mode Neobrutalism strictly requiring black text on light backgrounds */
        .dark .text-on-surface,
        .dark .text-primary-fixed-dim,
        .dark .text-on-surface-variant {
            color: #000 !important;
        }

        .dark .bg-surface {
            background-color: #fff !important;
        }

        .dark .border-primary-fixed-dim {
            border-color: #000 !important;
        }
    </style>
</head>
<body class="flex min-h-screen font-mono bg-gray-100">
    <!-- SideNavBar (JSON Blueprint + Neobrutalist overrides) -->
    <nav class="hidden md:flex fixed left-0 top-0 h-full w-[280px] bg-white border-r-[3px] border-black flex-col p-md gap-sm z-50">
        <div class="mb-lg">
            <h1 class="font-h1 text-h1 font-black italic text-black uppercase mb-1">CyberMail</h1>
            <p class="font-label text-label uppercase tracking-widest text-black">Admin Paneli</p>

            @await Component.InvokeAsync("UserProfilePhoto")

            <br />

            <p class="font-label text-label text-black mt-xs uppercase bg-brutal-yellow inline-block px-1 border border-black" style="font-size:large;">@User.Identity.Name</p>
        </div>

        <ul class="flex flex-col gap-2 flex-grow">
            <!-- Active: Dashboard -->
            <li>
                <a class="flex items-center gap-3 p-3 text-black font-bold border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase tracking-widest hover:translate-x-2 @(ViewBag.ActiveTab == "Dashboard" ? "bg-neo-yellow" : "hover:bg-neo-yellow") transition-transform tracking-widest uppercase" href="/Admin/Dashboard/">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "Dashboard" ? "1" : "0");">dashboard</span>
                    Dashboard
                </a>
            </li>
            <li>
                <a class="flex items-center gap-3 p-3 text-black font-bold border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase tracking-widest hover:translate-x-2 @(ViewBag.ActiveTab == "Users" ? "bg-neo-yellow" : "hover:bg-neo-yellow") transition-transform tracking-widest uppercase" href="/Admin/Users/">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "Users" ? "1" : "0");">group</span>
                    Kullanıcılar
                </a>
                @* <a class="flex items-center gap-md text-black brutal-border px-md py-sm brutal-shadow shadow-[4px_4px_0_0_#000] @(ViewBag.ActiveTab == "Users" ? "bg-neo-yellow" : "hover:bg-brutal-yellow") transition-colors" href="/Message/ImportantMessages/">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "ImportantMessages" ? "1" : "0");">star</span>
                    <span class="font-body-md text-body-md font-bold uppercase">Önemliler</span>
                </a> *@
            </li
            <li>
                <a class="flex items-center gap-3 p-3 text-black font-bold border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase tracking-widest hover:translate-x-2 @(ViewBag.ActiveTab == "Roles" ? "bg-neo-yellow" : "hover:bg-neo-yellow") transition-transform tracking-widest uppercase" href="/Admin/Roles/">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "Roles" ? "1" : "0");">identity_platform</span>
                    Roller
                </a>
            </li>
            <li>
                <a class="flex items-center gap-3 p-3 text-black font-bold border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase tracking-widest hover:translate-x-2 @(ViewBag.ActiveTab == "Statistics" ? "bg-neo-yellow" : "hover:bg-neo-yellow") transition-transform tracking-widest uppercase" href="/Admin/Statistics/">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "Statistics" ? "1" : "0");">business_messages</span>
                    Mesajlar
                </a>
            </li>
            <li>
                <a class="flex items-center gap-3 p-3 text-black font-bold border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase tracking-widest hover:translate-x-2 @(ViewBag.ActiveTab == "Complaints" ? "bg-neo-yellow" : "hover:bg-neo-yellow") transition-transform tracking-widest uppercase" href="/Admin/Complaints/">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "Complaints" ? "1" : "0");">sentiment_extremely_dissatisfied</span>
                    Şikayetler
                </a>
            </li>
            <li>
                <a class="flex items-center gap-3 p-3 text-black font-bold border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase tracking-widest hover:translate-x-2 @(ViewBag.ActiveTab == "Categories" ? "bg-neo-yellow" : "hover:bg-neo-yellow") transition-transform tracking-widest uppercase" href="/Admin/Categories/">
                    <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' @(ViewBag.ActiveTab == "Categories" ? "1" : "0");">bookmark_stacks</span>
                    Kategoriler
                </a>
            </li>
        </ul>
        <div class="mt-auto flex flex-col gap-2 border-t-[3px] border-black pt-4">
            <a class="flex items-center gap-3 p-3 text-black font-bold border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase tracking-widest hover:translate-x-2 hover:bg-neo-yellow transition-transform tracking-widest uppercase" href="/Message/Index/">
                <span class="material-symbols-outlined">web</span>
                CyberMail'e dön
            </a>
            <a class="flex items-center gap-3 p-3 text-black font-bold border-[3px] border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] uppercase tracking-widest hover:translate-x-2 hover:bg-brutal-red hover:text-white transition-transform tracking-widest uppercase" href="/Auth/Logout">
                <span class="material-symbols-outlined">logout</span>
                Logout
            </a>
        </div>
    </nav>
    <!-- BEGIN: MainContent -->
    <main class="flex-1 overflow-y-auto p-6 md:p-8 bg-neutral-50 md:ml-[280px]">
        @RenderBody()
    </main>
    <!-- END: MainContent -->
</body>
</html>