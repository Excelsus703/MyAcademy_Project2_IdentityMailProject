@model List<UserMessage>
@{
    ViewData["Title"] = "Önemli Mesajlar";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@if (!Model.Any())
{
    <main class="flex-1 flex flex-col h-full bg-background relative overflow-y-auto">
        <div class="flex-1 flex flex-col items-center justify-center p-xl text-center">
            <div class="mb-lg relative inline-block">
                <div class="absolute inset-0 bg-tertiary-fixed translate-x-3 translate-y-3 rounded-DEFAULT brutal-border"></div>
                <div class="relative bg-surface p-md rounded-DEFAULT brutal-border z-10 w-64 h-64 flex items-center justify-center">
                    <img class="w-full h-full object-contain" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAqrlVsxh4sMYziWTSh-XC6D81hPmv-hdxb1bZbu5KOdkJDqWNYibKx7kx1F7Jo4wK1oHuyAKe9XXbkGmMDfiSxdgOZYJtFPhFP04llAbKFUF_LYXP5HBPmNVhlY9My_XHKUTiaGH1d_X-kupksLkw2xoH8S6rFxZL5DLGVKzBVS-WE1T-DzxXmSJKGzmPBmr08AujQY9npKLGLtxcMgqli0YXhJqBtFC59mZFjM-a-0mubbq-jadi-" />
                </div>
            </div>
            <h2 class="font-h1 text-h1 font-black text-on-background uppercase tracking-tight mb-md px-md py-sm bg-tertiary-fixed brutal-border shadow-[4px_4px_0px_0px_rgba(29,27,32,1)] transform -rotate-1">
                BURASI HENÜZ YILDIZLANMAMIŞ!
            </h2>
            <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md mx-auto bg-surface p-sm brutal-border shadow-[2px_2px_0px_0px_rgba(29,27,32,1)]">
                Önemli mesajlarını yıldızla işaretleyerek burada toplayabilirsin.
            </p>
            <a class="mt-xl inline-flex items-center gap-sm px-lg py-sm bg-primary text-on-primary font-h2 text-h2 brutal-border shadow-[4px_4px_0px_0px_rgba(29,27,32,1)] brutal-shadow" href="/Message/Index/">
                <span class="material-symbols-outlined" data-icon="inbox">inbox</span>
                Gelen Kutusuna Dön
            </a>
        </div>
    </main>
}
else
{
    <main class="flex-1 mt-16 flex h-[calc(100vh-64px)] overflow-hidden">
        <!-- Message List -->
        <div class="w-[380px] flex flex-col brutal-border-r bg-white h-full overflow-y-auto">
            <div class="p-md brutal-border-b flex justify-between items-center bg-gray-100">
                <h2 class="font-h2 text-h2 font-bold uppercase">@ViewData["Title"]</h2>
                <div class="relative inline-block">
                    <select onchange="location = this.value;"
                            class="bg-white brutal-border font-bold text-sm uppercase p-1 pr-7 cursor-pointer outline-none">

                        <option value="@Url.Action("ImportantMessages", "Message", new { sortBy = "date_desc" })"
                                selected="@(ViewBag.CurrentSort == "date_desc" || string.IsNullOrEmpty(ViewBag.CurrentSort as string) ? "selected" : null)">
                            📅 En Yeni
                        </option>

                        <option value="@Url.Action("ImportantMessages", "Message", new { sortBy = "date_asc" })"
                                selected="@(ViewBag.CurrentSort == "date_asc" ? "selected" : null)">
                            📅 En Eski
                        </option>

                        <option value="@Url.Action("ImportantMessages", "Message", new { sortBy = "subject_asc" })"
                                selected="@(ViewBag.CurrentSort == "subject_asc" ? "selected" : null)">
                            🔤 Konu (A-Z)
                        </option>

                        <option value="@Url.Action("ImportantMessages", "Message", new { sortBy = "subject_desc" })"
                                selected="@(ViewBag.CurrentSort == "subject_desc" ? "selected" : null)">
                            🔤 Konu (Z-A)
                        </option>
                    </select>
                </div>
            </div>
            @foreach (var item in Model)
            {
                bool isActive = ViewBag.SelectedId != null && (int)ViewBag.SelectedId == item.Id;

                string cssClass;

                if (isActive == true)
                {
                    cssClass = "p-md brutal-border-b bg-brutal-yellow cursor-pointer relative group border-l-[8px] border-l-black hover:shadow-[8px_8px_0_0_#000]";
                }
                else
                {
                    cssClass = "p-md brutal-border-b bg-gray-100 hover:bg-gray-50 cursor-pointer opacity-70 hover:shadow-[4px_4px_0_0_#000]";
                }

                <a href="@Url.Action("ImportantMessages", "Message", new { id = item.Id, sortBy = ViewBag.CurrentSort })" class="@cssClass">
                    <div class="flex justify-between items-start mb-sm">
                        <span class="font-label font-bold text-label uppercase text-black">@item.Sender.FirstName @item.Sender.LastName</span>
                        <span class="font-label font-bold text-label text-black">@item.SendDate.ToLongDateString()</span>
                    </div>
                    @{
                        var shortSubject = @item.Subject.Length > 30 ? @item.Subject.Substring(0, 30) + "..." : @item.Subject;
                    }
                    <h3 class="font-body-lg text-body-lg font-bold text-black leading-tight mb-xs uppercase">@shortSubject</h3>
                    <p class="font-body-sm text-body-sm font-bold text-black truncate">
                        @{
                            var plainText = System.Text.RegularExpressions.Regex.Replace(item.Body ?? "", "<.*?>", string.Empty);
                            var preview = plainText.Length > 50 ? plainText.Substring(0, 30) + "..." : plainText;
                        }
                        @preview
                    </p>
                </a>
            }
        </div>
        <!-- Message View -->
        @await Component.InvokeAsync("UserMessageDetail", new { id = ViewBag.SelectedId })
    </main>
}
