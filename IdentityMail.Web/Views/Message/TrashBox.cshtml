@model List<UserMessage>
@{
    ViewData["Title"] = "Çöp Kutusu";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@if (!Model.Any())
{
    <main class="flex-1 mt-16 flex h-[calc(100vh-64px)] overflow-hidden">
        <div class="flex-1 flex flex-col items-center justify-center bg-white p-lg h-full">
            <div class="max-w-md w-full flex flex-col items-center text-center">
                <div class="brutal-border brutal-shadow mb-xl overflow-hidden bg-brutal-yellow">
                    <img alt="Empty Trash Bin Illustration" class="w-full h-auto block" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD78TeXePC3ad7uw6iV538hB5UfsYf7a3E8Tr5fcOy81DDplxxQsisG1Csimf2ZCPwEnRV3soXG669b0ypwKEHCP_2MItO0gXbiqJnc7u8Pv9yfHS6No3NeobWDGsOrks8IiIgXJ5ppKC9nVNVSzNMLSCR107e3_DHB5-EQQ9BkLQZqPK4BqoOAxQgctJxy7jqwTaeFHTLxRH2facLMxwEVH7Pxq5H-Uwv_zkXfr6-3lpAEgE2B6-ga" />
                </div>
                <h2 class="font-h1 text-h1 font-black uppercase text-black bg-brutal-yellow inline-block brutal-border p-md shadow-[8px_8px_0_0_#000] mb-md">
                    ÇÖP KUTUSU TERTEMİZ!
                </h2>
                <p class="font-body-lg text-body-lg font-bold text-black uppercase tracking-tight">
                    Burada silinmiş bir mesaj yok. Keyfini çıkar!
                </p>
            </div>
        </div>
    </main>
}
else
{
    <main class="flex-1 mt-16 flex h-[calc(100vh-64px)] overflow-hidden">
        <!-- Message List -->
        <div class="w-[380px] flex flex-col brutal-border-r bg-white h-full overflow-y-auto">
            <div class="p-md brutal-border-b flex justify-between items-center bg-gray-100">
                <h2 class="font-h2 text-h2 font-bold uppercase">@ViewData["Title"]</h2>
            </div>
            @foreach (var item in Model)
            {
                bool isActive = ViewBag.SelectedMessageId != null && (int)ViewBag.SelectedMessageId == item.Id;

                string cssClass;

                if (isActive == true)
                {
                    cssClass = "p-md brutal-border-b bg-brutal-yellow cursor-pointer relative group border-l-[8px] border-l-black hover:shadow-[8px_8px_0_0_#000]";
                }
                else
                {
                    cssClass = "p-md brutal-border-b bg-gray-100 hover:bg-gray-50 cursor-pointer opacity-70 hover:shadow-[4px_4px_0_0_#000]";
                }

                <a href="@Url.Action("TrashBox", "Message", new { id = item.Id })" class="@cssClass">
                    <div class="flex justify-between items-start mb-sm">
                        <span class="font-label font-bold text-label uppercase text-black">@item.Sender.FirstName @item.Sender.LastName</span>
                        <span class="font-label font-bold text-label text-black">@item.SendDate.ToLongDateString()</span>
                    </div>
                    @{
                        var shortSubject = @item.Subject.Length > 30 ? @item.Subject.Substring(0, 30) + "..." : @item.Subject;
                    }
                    <h3 class="font-body-lg text-body-lg font-bold text-black leading-tight mb-xs uppercase">@shortSubject</h3>
                    <p class="font-body-sm text-body-sm font-bold text-black truncate">
                        @{
                            var plainText = System.Text.RegularExpressions.Regex.Replace(item.Body ?? "", "<.*?>", string.Empty);
                            var preview = plainText.Length > 50 ? plainText.Substring(0, 30) + "..." : plainText;
                        }
                        @preview
                    </p>
                </a>
            }
        </div>
        <!-- Message View -->
        @await Component.InvokeAsync("UserMessageTrashDetail", new { id = ViewBag.SelectedMessageId })
    </main>
}