@model List<UserMessage>
@{
    ViewData["Title"] = "Gönderilen Mesajlar";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}


@if (!Model.Any())
{
    <main class="flex-1 pt-16 flex flex-col items-center justify-center p-xl overflow-y-auto relative">
        <!-- Abstract background elements to reinforce neobrutalism without being full backgrounds -->
        <div class="absolute top-1/4 left-1/4 w-32 h-32 bg-primary-container border-4 border-on-surface rounded-full opacity-20 -z-10 mix-blend-multiply"></div>
        <div class="absolute bottom-1/4 right-1/4 w-48 h-48 bg-tertiary-container border-4 border-on-surface opacity-20 -z-10 mix-blend-multiply transform rotate-12"></div>
        <div class="max-w-2xl w-full flex flex-col items-center text-center">
            <!-- Main Illustration -->
            <div class="w-64 h-64 md:w-96 md:h-96 mb-xl relative group">
                <div class="absolute inset-0 bg-on-surface translate-x-4 translate-y-4"></div>
                <img alt="Paper Airplane Illustration" class="w-full h-full object-cover border-4 border-on-surface relative z-10 transition-transform duration-300 group-hover:-translate-y-2 group-hover:-translate-x-2 bg-white p-sm" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCy21OHUCm5AtPqy1lsD-ynN_KBk1aeglbf1jIm1BB_TESMyMGeMjT87IkiDEQQP5mEsrooxUHztMoXNkZhLuR05uUsOnM5hqwbaD9VD7lyQrtfVIhQ3msKkClnpB_Yj3iGHVBeNsRkHttjMS6xOMz8zBecfwqNRR7-AYu0wPg9wrqj1ELZcYJ01YGhD3l-w-xMjJAM5hyvh8IwhXPPCYDOiVmJdhBRXg6QXkJ8CSBDchI_Ft28jVfM" />
            </div>
            <!-- Title -->
            <div class="bg-tertiary-fixed border-4 border-on-surface px-lg py-md mb-lg neobrutalist-shadow transform -rotate-2 hover:rotate-0 transition-transform duration-300">
                <h2 class="font-h1 text-h1 font-black text-on-surface uppercase tracking-tighter">HİÇ MESAJ GÖNDERİLMEMİŞ!</h2>
            </div>
            <!-- Description -->
            <div class="bg-white border-2 border-on-surface p-md mb-xl neobrutalist-shadow max-w-lg">
                <p class="font-body-lg text-body-lg text-on-surface font-bold leading-relaxed">
                    Henüz kimseye e-posta göndermediniz. İlk mesajınızı yazmaya ne dersiniz? Gönderilen tüm e-postalarınız burada listelenecek.
                </p>
            </div>
            <!-- CTA Action -->
            <a href="/Message/SendMail/" class="bg-primary text-on-primary font-h1 text-h2 font-black uppercase py-md px-xl border-4 border-on-surface brutal-shadow transition-all tracking-wide flex items-center gap-sm">
                <span class="material-symbols-outlined text-3xl font-black">edit_square</span>
                MESAJ YAZ
            </a>
        </div>
    </main>
}
else
{
    <main class="flex-1 mt-16 flex h-[calc(100vh-64px)] overflow-hidden">
        <!-- Message List -->
        <div class="w-[380px] flex flex-col brutal-border-r bg-white h-full overflow-y-auto">
            <div class="p-md brutal-border-b flex justify-between items-center bg-gray-100">
                <h2 class="font-h2 text-h2 font-bold uppercase">@ViewData["Title"]</h2>
            </div>
            @foreach (var item in Model)
            {
                bool isActive = ViewBag.SelectedId != null && (int)ViewBag.SelectedId == item.Id;

                string cssClass;

                if (isActive == true)
                {
                    cssClass = "p-md brutal-border-b bg-brutal-yellow cursor-pointer relative group border-l-[8px] border-l-black hover:shadow-[8px_8px_0_0_#000]";
                }
                else
                {
                    cssClass = "p-md brutal-border-b bg-gray-100 hover:bg-gray-50 cursor-pointer opacity-70 hover:shadow-[4px_4px_0_0_#000]";
                }

                <a href="@Url.Action("SentMessages", "Message", new { id = item.Id })" class="@cssClass">
                    <div class="flex justify-between items-start mb-sm">
                        <span class="font-label font-bold text-label uppercase text-black">@item.Sender.FirstName @item.Sender.LastName</span>
                        <span class="font-label font-bold text-label text-black">@item.SendDate.ToLongDateString()</span>
                    </div>
                    @{
                        var shortSubject = @item.Subject.Length > 30 ? @item.Subject.Substring(0, 30) + "..." : @item.Subject;
                    }
                    <h3 class="font-body-lg text-body-lg font-bold text-black leading-tight mb-xs uppercase">@shortSubject</h3>
                    <p class="font-body-sm text-body-sm font-bold text-black truncate">
                        @{
                            var plainText = System.Text.RegularExpressions.Regex.Replace(item.Body ?? "", "<.*?>", string.Empty);
                            var preview = plainText.Length > 50 ? plainText.Substring(0, 30) + "..." : plainText;
                        }
                        @preview
                    </p>
                </a>
            }
        </div>
        <!-- Message View -->
        @await Component.InvokeAsync("UserMessageDetail", new { id = ViewBag.SelectedId })
    </main>
}